{% comment %}
  ESCAPE CLOTHING 17 - STREETWEAR FOOTER HUD & NAGPUR INTEGRATIVE MAP
{% endcomment %}
<footer class="escape-footer" id="find-us">
  <div class="container footer-layout">
    
    <!-- Left Section: Coordinates & Brand Identity -->
    <div class="footer-brand-box">
      <div class="footer-logo-row">
        <span class="footer-dot-green"></span>
        <div class="footer-logo-text">
          <h3 class="footer-brand-title">ESCAPE CLOTHING 17</h3>
          <span class="footer-city-label">NAGPUR STREETWEAR SANCTUARY</span>
        </div>
      </div>

      <p class="footer-brand-p">
        Nagpur's high-energy streetwear drops. Standardizing premium heavy fabric weaves for students without crazy markups. Use our custom Shopify 2.0 checkout for instantaneous deliveries.
      </p>

      <!-- Nagpur Support Dial Units -->
      <div class="contact-operator-grid">
        <div class="header-pre border-none pb-2 font-bold select-none" style="margin-bottom: 0;">
          [ NAGPUR HOTLINE SUPPORT DIRECTORY ]
        </div>
        
        <div class="operators-row">
          <div class="operator-node">
            <span class="operator-meta">SURESH (SALES SUPPORT)</span>
            <span class="operator-display">+91 82610 94774</span>
          </div>
          <div class="operator-node">
            <span class="operator-meta">ROHIT (OUT-OF-TOWN OPERATIONS)</span>
            <span class="operator-display">+91 90223 41807</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Section: Google Maps Nagpur center locator -->
    <div class="footer-map-column">
      <div class="map-header-row">
        <span class="map-pre-label">[ SHOP ADDRESS COORDINATE ]</span>
        <a href="https://maps.google.com/?q=City+Center+Mall+Nagpur+Maharashtra+India" target="_blank" class="map-link">
          OPEN NATIVE MAP &rarr;
        </a>
      </div>

      <div class="map-iframe-container">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3721.4699564275154!2d79.09887729999999!3d21.1336829!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd4bd6aa32a24d7%3A0xc3b95a8947bde935!2sCity+Center!5e0!3m2!1sen!2sin!4v1780928834000!5m2!1sen!2sin&q=City+Center+Mall+Nagpur+Maharashtra" 
          width="100%" 
          height="100%" 
          style="border: 0; filter: grayscale(1) invert(0.92) contrast(1.1) brightness(0.95);" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer"
          title="City Center Mall Nagpur Google Maps Embed"
        ></iframe>
      </div>

      <div class="location-comment">
        <span class="white-star">★</span>
        <p className="comment-text">
          <strong>Nagpur Walk-ins:</strong> Avoid shipping delays entirely! Assemble your streetwear selection on our Shopify checkout and select same-day in-store counter pick-up at City Center Mall, Nagpur.
        </p>
      </div>
    </div>

  </div>

  <!-- Bottom Legal Base credits -->
  <div class="footer-legal-bar border-top container">
    <span class="legal-copy">&copy; {{ 'now' | date: "%Y" }} ESCAPE CLOTHING 17. ALL RIGHTS RESERVED.</span>
    <span class="legal-tag uppercase font-mono">Deals on fabric at reasonable rates.</span>
  </div>
</footer>

<style>
  .escape-footer {
    background: #050505;
    border-top: 1px solid #141414;
    padding: 5rem 0 3rem;
  }

  .footer-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 992px) {
    .footer-layout {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 5rem;
    }
  }

  /* Left Panel styling */
  .footer-brand-box {
    display: flex;
    flex-direction: column;
  }

  .footer-logo-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .footer-dot-green {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-neon-primary);
    box-shadow: 0 0 10px var(--color-neon-primary);
  }

  .footer-brand-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
    letter-spacing: 0.15em;
  }

  .footer-city-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: #555555;
    letter-spacing: 0.2em;
    display: block;
    margin-top: 0.15rem;
  }

  .footer-brand-p {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #666;
    line-height: 1.6;
    margin: 0 0 2.5rem 0;
    max-width: 500px;
  }

  /* Contact and node listings */
  .contact-operator-grid {
    background: #090909;
    border: 1px solid #121212;
    padding: 1.5rem;
    border-radius: 8px;
  }

  .operators-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  @media (min-width: 480px) {
    .operators-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .operator-node {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .operator-meta {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    color: var(--color-neon-primary);
  }

  .operator-display {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 900;
    color: #ffffff;
  }

  /* Right column: Google mapping integrations */
  .footer-map-column {
    display: flex;
    flex-direction: column;
  }

  .map-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .map-pre-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 900;
    color: #888888;
    letter-spacing: 0.05em;
  }

  .map-link {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-neon-primary);
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .map-link:hover {
    text-decoration: underline;
  }

  .map-iframe-container {
    aspect-ratio: 16/9;
    background: #000;
    border: 1px solid #141414;
    border-radius: 12px;
    overflow: hidden;
    padding: 0.35rem;
  }

  .location-comment {
    display: flex;
    gap: 0.75rem;
    background: #090909;
    border: 1px dashed #141414;
    padding: 1rem;
    border-radius: 6px;
    margin-top: 1.25rem;
  }

  .white-star {
    color: var(--color-neon-primary);
    font-weight: bold;
  }

  .comment-text {
    font-family: var(--font-sans);
    font-size: 0.73rem;
    color: #555555;
    line-height: 1.45;
    margin: 0;
  }

  /* Bottom line margins */
  .footer-legal-bar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    border-top: 1px solid #121212;
    padding-top: 2rem;
  }

  @media (min-width: 768px) {
    .footer-legal-bar {
      flex-direction: row;
    }
  }

  .legal-copy {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: #444444;
  }

  .legal-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    color: #444444;
    letter-spacing: 0.05em;
  }
</style>

{% schema %}
{
  "name": "Streetwear Footer",
  "settings": []
}
{% endschema %}
